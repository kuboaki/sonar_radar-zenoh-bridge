{
  mode: "router",
  listen: {
    endpoints: [
      "tcp/0.0.0.0:7447"
    ]
  },
  plugins: {
    rest: {
      http_port: 8000
    },
    storage_manager: {
      volumes: {
        memory: {}
      },
      storages: {
        radar: {
          key_expr: "radar/**",
          volume: "memory"
        }
      }
    }
  }
}
